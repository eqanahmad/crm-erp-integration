# Local-only credentials. up.sh copies this file to .env and fills in random
# passwords the first time it runs. .env is git-ignored. Never use these in Azure.

ESPO_PORT=8081
ERP_PORT=8082
INSPECTOR_PORT=8083

ESPOCRM_VERSION=10
ERPNEXT_VERSION=v16.55.0

ESPO_ADMIN_PASSWORD=__RANDOM__
ESPO_DB_PASSWORD=__RANDOM__
ESPO_DB_ROOT_PASSWORD=__RANDOM__

ERP_ADMIN_PASSWORD=__RANDOM__
ERP_DB_ROOT_PASSWORD=__RANDOM__

# SQL Server needs upper, lower, digit and symbol.
SB_SQL_PASSWORD=__RANDOM_SQL__

# Filled in by up.sh after it checks which images have ARM64 builds.
ERPNEXT_PLATFORM=linux/arm64
SB_PLATFORM=linux/amd64

# ERPNext company created by the seed job.
ERP_COMPANY="Portage Logistics"
ERP_COMPANY_ABBR=PL
ERP_COUNTRY=Canada
ERP_CURRENCY=CAD
ERP_TIMEZONE=America/Toronto
